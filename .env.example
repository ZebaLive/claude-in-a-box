# Copy to .env, fill in, then:  set -a && . ./.env && set +a
# (see INSTALL.md for the full agent-driven install flow)
# .env is gitignored. Never commit real keys.

EXA_API_KEY=xxxxxxxx                    # https://exa.ai

# Optional:
# CONTEXT7_API_KEY=ctx7sk-xxxxxxxx      # https://context7.com — only raises ctx7 CLI rate limits
# CLAUDE_CONFIG_DIR=~/.claude           # override Claude config dir
#
# jina, OTel, and rtk are not optional — this stack is opinionated and always
# installs them (docker/colima are hard requirements, see INSTALL.md).
