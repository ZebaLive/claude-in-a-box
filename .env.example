# Copy to .env, fill in, then:  set -a && . ./.env && set +a && ./install.sh
# .env is gitignored. Never commit real keys.

CONTEXT7_API_KEY=ctx7sk-xxxxxxxx        # https://context7.com
EXA_API_KEY=xxxxxxxx                    # https://exa.ai

